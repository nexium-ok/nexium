@page "/internal/create-place"
@model Roblox.Website.Pages.Internal.CreatePlace

@{
    Layout = "Shared/_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-lg-6 offset-lg-3">
            <h3>Create a Place</h3>
            <div class="alert alert-warning mt-3">
                <strong>Note:</strong> Making a place will deduct <strong>350 Robux</strong> from your account.
            </div>
            @if (Model.successUrl != null)
            {
                <p class="mt-4 mb-4">
                    <span class="text-success">Place created successfully.</span>
                    To upload your game, click <a href="@Model.successUrl">here</a>.
                    You should bookmark the upload URL since it is not visible elsewhere.
                </p>
            }
            else if (Model.errorMessage != null)
            {
                <p class="mt-4 mb-4">
                    <span class="text-danger">@Model.errorMessage</span>
                </p>
            }
            <div class="mt-4">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="submit" class="btn btn-primary" value="Create Place"/>
                </form>
            </div>
        </div>
    </div>
</div>